// A trimmed VS Code theme in the shape extensions ship: comments, trailing
// commas, #rgba and #rrggbbaa colors, workbench colors and tokenColors.
{
  "$schema": "vscode://schemas/color-theme",
  "name": "Night Owl (fixture)",
  "type": "dark",
  "colors": {
    "editor.background": "#011627",
    "editor.foreground": "#d6deeb",
    "focusBorder": "#122d42",
    "button.background": "#7e57c2cc", // translucent: skipped for the accent
    "activityBarBadge.background": "#44596b",
    "editorCursor.foreground": "#80a4c2",
    "editor.selectionBackground": "#1d3b53",
    "editorLineNumber.foreground": "#4b6479",
    "editorWidget.background": "#021320",
    "input.background": "#0b253a",
    "panel.border": "#5f7e97",
    "editorError.foreground": "#ef5350",
    "editorWarning.foreground": "#b39554",
    "editorGroup.border": "#011627f0",
    "terminal.ansiBlack": "#011627",
    "terminal.ansiRed": "#ef5350",
    "terminal.ansiGreen": "#22da6e",
    "terminal.ansiYellow": "#c5e478",
    "terminal.ansiBlue": "#82aaff",
    "terminal.ansiMagenta": "#c792ea",
    "terminal.ansiCyan": "#21c7a8",
    "terminal.ansiWhite": "#fff",
    "terminal.ansiBrightBlack": "#575656",
    "terminal.ansiBrightRed": "#ef5350",
    "terminal.ansiBrightGreen": "#22da6e",
    "terminal.ansiBrightYellow": "#ffeb95",
    "terminal.ansiBrightBlue": "#82aaff",
    "terminal.ansiBrightMagenta": "#c792ea",
    "terminal.ansiBrightCyan": "#7fdbca",
    "terminal.ansiBrightWhite": "#ffff",
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#637777", "fontStyle": "italic" },
    },
    { "scope": "string.quoted", "settings": { "foreground": "#ecc48d" } },
    { "scope": "keyword, storage.type", "settings": { "foreground": "#c792ea" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#82aaff" } },
    { "scope": "entity.name.type", "settings": { "foreground": "#ffcb8b" } },
    { "scope": "punctuation", "settings": { "foreground": "#c792ea80" } },
  ],
}
