    "cmdk": "1.1.1",
    "culori": "^4.0.2",
    "dompurify": "^3.4.18",
    "fuzzysort": "4.0.2",
    "jsonc-parser": "^3.3.1",
    "lucide-react": "^1.75.0",
    "marked": "^18.2.1",
    "material-icon-theme": "5.40.0",
    "radix-ui": "^1.8.1",
