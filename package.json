{
  "name": "midterm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:bridge": "bun build src/claude/bridge/main.ts --target=node --format=esm --outfile=src-tauri/resources/claude-bridge.mjs",
    "dev": "bun run build:bridge && vite",
    "dev:mcp": "tauri dev --features tauri-mcp --config src-tauri/tauri.mcp.conf.json",
    "build": "bun run build:bridge && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri"
  },
  "dependencies": {
