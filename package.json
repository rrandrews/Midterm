    "@tauri-apps/cli": "^2",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@xterm/headless": "6.0.0",
    "happy-dom": "^21.0.4",
    "jsdom": "^31",
