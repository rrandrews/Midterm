{
  "identifier": "com.ron.midterm.mcp",
  "build": {
    "beforeDevCommand": "MIDTERM_DEV_PORT=1430 bun run dev",
    "devUrl": "http://localhost:1430"
  },
  "app": {
    "windows": [
      {
        "title": "midterm (mcp)",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0C0D10"
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": {
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430 http://127.0.0.1:*"
      },
      "capabilities": [
        "default",
        {
          "identifier": "tauri-mcp",
          "description": "MCP bridge for the Midterm development window",
          "windows": [
            "main"
          ],
          "permissions": [
            "mcp-bridge:default"
          ]
        }
      ],
      "devCsp": {
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1430 http://localhost:1430 http://127.0.0.1:*"
      }
    }
  }
}
