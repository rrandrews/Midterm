{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "midterm",
  "version": "0.1.0",
  "identifier": "com.ron.midterm",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "midterm",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 400,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#0C0D10"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' plugin: http://plugin.localhost",
        "style-src": "'self' 'unsafe-inline' plugin: http://plugin.localhost",
        "img-src": "'self' blob: data: plugin: http://plugin.localhost",
        "media-src": "'self' blob:",
        "font-src": "'self' data: plugin: http://plugin.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline' plugin: http://plugin.localhost",
        "style-src": "'self' 'unsafe-inline' plugin: http://plugin.localhost",
        "img-src": "'self' blob: data: plugin: http://plugin.localhost",
        "media-src": "'self' blob:",
        "font-src": "'self' data: plugin: http://plugin.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420 http://127.0.0.1:*",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
